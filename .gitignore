# Ignore everything
/*

# Keep gitignore itself
!.gitignore

# Allow the project folder
!/CourseManagementBackend/
!/FrontEnd/

# Inside MyProject, allow only pom.xml and src
/CourseManagementBackend/*
!/CourseManagementBackend/pom.xml
!/CourseManagementBackend/src/
!/CourseManagementBackend/src/**

# Explicitly ignore backend build output
/CourseManagementBackend/target/


# Common OS / Editor files
.DS_Store
.idea/
.vscode/